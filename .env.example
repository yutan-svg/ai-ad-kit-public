# このファイルを .env という名前でコピーして、使うサービスの値だけ入れます。
#   cp .env.example .env
# .env は Git に入らない設定済みです。キーは他人に見せない・チャットに貼らない。
# 全部を用意する必要はありません。使う道具の分だけで動きます。

# --- AI 映像制作ツール（Seedance）: 人がセリフを話す映像を作る -----------------
# 標準はこれです。ここが入っていれば scripts/generate_lines.py と
# scripts/generate_talking_head.py が動きます。
# 取得先: https://console.byteplus.com/ark  → API Key 管理 → 新しいキーを作成
ARK_API_KEY=

# 使うモデルの ID（サービスのモデル一覧に出ている名前）。空なら標準のモデルを使います。
SEEDANCE_MODEL=

# --- Google の映像モデル（Veo／Omni）・参照画像・検品 -------------------------
# この1本の鍵で、Google 完結型の4つがすべて動きます（scripts/generate_google.py と検品）。
#   Veo 3.1        人がセリフを話すクリップ（秒単価。4／6／8秒）
#   Omni 1.1 Flash 同上（トークン課金。秒単価の公表なし）
#   Nano Banana 2  参照画像を1枚つくる（同じ人物を保つ土台）
#   Gemini 文字起こし  検品の音声認識（whisper の代わりに使えます）
# 手順は guides/google-models.md。取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Google Cloud の読み上げ（Chirp 3 HD）------------------------------------
# scripts/generate_tts.py が使います。ここに書くキーはありません。
# 次のどちらかで認証します（どちらでも動きます）:
#   A) gcloud CLI がある場合:  gcloud auth application-default login
#   B) gcloud CLI が無い場合:  認証ファイル（application_default_credentials.json）を
#      所定の場所に置くだけで動きます。スクリプトが自分で読みます。
# 使うプロジェクトを明示したいときだけ、次を設定します。
# GOOGLE_CLOUD_PROJECT=
